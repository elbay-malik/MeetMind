{
  // The deployment: MeetMind on the Workers free plan, at meetmind.elbaymalik.com. README's
  // "Deploying the Worker" has the steps, and `pnpm deploy:worker` is the one way to run this,
  // since it builds for Workers first and refuses a build that is not. ADR-0009 measured what fits.
  //
  // Do not run `wrangler dev` at the repo root on a Worker build. It reads the real .env, and so
  // writes to the real database and spends real quota. The scripts/verify-worker-*.mjs run it
  // from a temporary copy with fakes, which is the way to see this under workerd.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meetmind",
  "main": ".output/server/index.mjs",

  // A custom domain on the account's one zone, because a WAF rate rule applies only to a zone
  // (SEC-07): a flood would otherwise spend the 100,000 requests a day of every Worker on the
  // account. Both of the other public hostnames are off, as neither has that rule. Wrangler
  // leaves preview_urls as it was if the key is left out.
  "routes": [
    { "pattern": "meetmind.elbaymalik.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,

  // nodejs_compat is REQUIRED, not optional: the cloudflare_module build warns
  // "Node.js compatibility is not enabled" without it, because every
  // server/utils/db/*-local.ts driver imports node:path eagerly (ADR-0008's
  // follow-up flags exactly this). Dated past 2024-09-23 so the v2 semantics
  // apply.
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    // The rate rule leaves /_nuxt/ out, or one page's assets would trip it, so nothing under
    // /_nuxt/ may run the Worker: by default a path with no asset does, and one address could
    // then spend the 100,000 requests a day with the rule counting none (SEC-07). Everything
    // else goes to the Worker first, which hands its assets on, and the rule counts all of that.
    "run_worker_first": ["/*", "!/_nuxt/*"]
  },

  // ADR-0012's sweeper: one step of one meeting, or the keep-alive when there is none. On a
  // deployed Worker only, since `wrangler dev` does not run these by itself and a Node server
  // has none. The free plan allows 5 across the account. The page says "every 5 minutes", and
  // tests/unit/sweep-source.spec.ts holds the two together.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "observability": {
    // CPU time per invocation, against the free plan's 10 ms, which only the edge can say.
    "enabled": true
  }
}
