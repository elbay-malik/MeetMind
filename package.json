{
  "name": "meetmind",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && node scripts/copy-ffmpeg-core.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "nuxt build && vitest run --config vitest.e2e.config.ts",
    "test:services": "vitest run --config vitest.services.config.ts",
    "test:postgrest": "vitest run --config vitest.postgrest.config.ts",
    "db:migrate": "bash scripts/apply-migrations.sh",
    "upload:ffmpeg-wasm": "node scripts/upload-ffmpeg-wasm.mjs",
    "ci:local": "bash scripts/ci-local.sh",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@nuxt/ui": "^4.12.0",
    "@supabase/supabase-js": "2.115.0",
    "aws4fetch": "1.0.20",
    "nuxt": "^4.6.3",
    "tailwindcss": "^4.3.3",
    "unstorage": "1.17.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
  "devDependencies": {
    "@ffmpeg/core": "0.12.10",
    "@iconify-json/lucide": "^1.2.149",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "happy-dom": "^20.14.6",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.156.0"
  }
}
