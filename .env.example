# Server-only secrets. Nuxt maps NUXT_FOO_BAR -> runtimeConfig.fooBar at runtime.
# Copy to .env for local development; never commit .env.
#
# Everything below is optional for `pnpm dev`: without the R2 and Supabase settings
# the server stores audio and meeting rows under .data/, and stubs stand in for Groq
# and Workers AI. The exception is NUXT_INVITE_CODE: without it, uploading is closed.
#
# A built server has no stand-ins. With any setting of Groq, Workers AI, Supabase or R2
# missing it answers 503 and logs the names of what is missing. And whichever way it
# runs, half of a group is refused, and so is a real database or bucket with anything
# else missing: a stub's output would be stored for good (ADR-0016).

# Transcription / LLM
NUXT_GROQ_API_KEY=

# Cloudflare Workers AI embeddings (ADR-0014). Both must be set; without them, under
# `pnpm dev`, a local stub embeds. The free plan has 10,000 neurons a day, resetting at 00:00 UTC,
# after which indexing and questions are refused until then. The token should be
# scoped to Workers AI alone: it is neither CLOUDFLARE_API_TOKEN below nor the R2 keys.
NUXT_WORKERS_AI_ACCOUNT_ID=
NUXT_WORKERS_AI_API_TOKEN=

# Supabase Postgres (meeting metadata). Service-role key, never the anon key.
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_KEY=

# Schema migrations only -- `pnpm db:migrate` reads this and nothing else does.
# Deliberately not NUXT_-prefixed: the server never opens a Postgres socket, it
# goes through PostgREST with the two variables above, so this must not reach
# the runtime config.
#
# Take the SESSION POOLER string from the dashboard (Connect -> Session pooler):
#   postgresql://postgres.<ref>:<password>@aws-N-<region>.pooler.supabase.com:5432/postgres
# Not the Direct connection (db.<ref>.supabase.co is IPv6-only on new projects,
# and Docker's bridge cannot route it), and not the Transaction pooler on 6543
# (it cannot run DDL). The dashboard writes a literal [YOUR-PASSWORD] into the
# string; replace it, and percent-encode any of : / ? # [ ] @ in the password.
SUPABASE_DB_URL=

# Self-imposed storage ceiling, in bytes. R2 has NO spending cap -- past the free
# allowance Cloudflare bills rather than refusing -- so this is the hard stop:
# POST /api/meetings answers 507 once the stored bytes plus the incoming upload
# would cross it. Default 8 GiB, under R2's 10 GB-month free tier. 0 disables the
# check; a value that is not a number throws rather than silently removing it.
NUXT_R2_MAX_STORED_BYTES=
# Days the bucket's lifecycle rule keeps audio. MUST match the rule actually on
# the bucket (`wrangler r2 bucket lifecycle list <bucket>`): it is how the byte
# estimate above knows which uploads Cloudflare has already deleted, and nothing
# in the app can check that the two agree. 0 means no rule, so nothing expires.
NUXT_R2_RETENTION_DAYS=

# Days after which the cron sweeper deletes a meeting and everything stored for it: the row, its
# transcript, summary and index, and its audio (ADR-0017). Irreversible, and with nobody watching, so
# it is OFF: leave this empty, or 0. Anything but a positive whole number is off as well, and logged.
# It also stays off without NUXT_PUBLIC_DEMO_MEETING_ID, since the demo could not be left out, and
# anywhere but a deployed Worker, which is the only thing with a cron. The upload page promises
# deletion only while it is really on.
NUXT_RETENTION_PURGE_DAYS=

# Cloudflare R2 (compressed audio). All four must be set to enable the R2 driver.
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_BUCKET=

# Admin-only routes (DELETE /api/meetings/:id), sent as `Authorization: Bearer`.
# Leave empty to disable them (they answer 404). At least 32 characters:
#   openssl rand -base64 32
NUXT_ADMIN_TOKEN=

# The code uploading needs (ADR-0015), sent as `Authorization: Bearer`. Leaving this
# empty never selects a stub, even under `pnpm dev`: empty, or under 32
# characters, closes uploads for everyone. Printable ASCII only, since it travels in a
# header. Rotating it locks out everyone who has the old one; existing links keep working.
#   openssl rand -hex 24
NUXT_INVITE_CODE=

# The meeting the home page links to (ADR-0013). Every other meeting is reachable
# only through its own link. Leave empty for no demo link. A value that is not a UUID
# hides the link and logs a warning. A deleted meeting's id still shows it, and it opens
# a 404, so clear this when deleting the demo. The meeting it names can only be read and
# asked, so finish the meeting first: see "Creating the demo meeting" in ADR-0015.
NUXT_PUBLIC_DEMO_MEETING_ID=

# Local drivers only
# NUXT_ALLOW_LOCAL_DRIVERS=true  # lets a BUILT server run on stubs and local stores, as the
#                                  e2e and browser jobs do. `pnpm dev` does not need it. Not
#                                  for a deployment: a Cloudflare Worker ignores it (ADR-0016).
# NUXT_UPLOAD_TOKEN_SECRET=   # HMAC secret for local upload URLs (random per process if empty)
# NUXT_DATA_DIR=.data         # where the local drivers keep audio/ and db/

# Cloudflare API (wrangler: deploy, versions upload, tail). CONTROL PLANE.
# Not the same credential as the R2 keys above: those are S3-style data-plane
# keys the app signs requests with at runtime. See docs/adr/0009-*.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
