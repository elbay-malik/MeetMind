# Server-only secrets. Nuxt maps NUXT_FOO_BAR -> runtimeConfig.fooBar at runtime.
# Copy to .env for local development; never commit .env.
#
# Everything below is optional for local development: without the R2 and
# Supabase settings the server stores audio and meeting rows under .data/.

# Transcription / LLM / embeddings (later phases)
NUXT_GROQ_API_KEY=
NUXT_GEMINI_API_KEY=

# Supabase Postgres (meeting metadata). Service-role key, never the anon key.
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_KEY=

# Cloudflare R2 (compressed audio). All four must be set to enable the R2 driver.
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_BUCKET=

# Local drivers only
# NUXT_UPLOAD_TOKEN_SECRET=   # HMAC secret for local upload URLs (random per process if empty)
# NUXT_DATA_DIR=.data         # where the local drivers keep audio/ and db/
