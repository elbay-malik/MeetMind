# Server-only secrets. Nuxt maps NUXT_FOO_BAR -> runtimeConfig.fooBar at runtime.
# Copy to .env for local development; never commit .env.
#
# Everything below is optional for local development: without the R2 and
# Supabase settings the server stores audio and meeting rows under .data/.

# Transcription / LLM / embeddings (later phases)
NUXT_GROQ_API_KEY=
NUXT_GEMINI_API_KEY=

# Supabase Postgres (meeting metadata). Service-role key, never the anon key.
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_KEY=

# Schema migrations only -- `pnpm db:migrate` reads this and nothing else does.
# Deliberately not NUXT_-prefixed: the server never opens a Postgres socket, it
# goes through PostgREST with the two variables above, so this must not reach
# the runtime config.
#
# Take the SESSION POOLER string from the dashboard (Connect -> Session pooler):
#   postgresql://postgres.<ref>:<password>@aws-N-<region>.pooler.supabase.com:5432/postgres
# Not the Direct connection (db.<ref>.supabase.co is IPv6-only on new projects,
# and Docker's bridge cannot route it), and not the Transaction pooler on 6543
# (it cannot run DDL). The dashboard writes a literal [YOUR-PASSWORD] into the
# string; replace it, and percent-encode any of : / ? # [ ] @ in the password.
SUPABASE_DB_URL=

# Cloudflare R2 (compressed audio). All four must be set to enable the R2 driver.
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_BUCKET=

# Local drivers only
# NUXT_UPLOAD_TOKEN_SECRET=   # HMAC secret for local upload URLs (random per process if empty)
# NUXT_DATA_DIR=.data         # where the local drivers keep audio/ and db/

# Cloudflare API (wrangler: deploy, versions upload, tail). CONTROL PLANE.
# Not the same credential as the R2 keys above: those are S3-style data-plane
# keys the app signs requests with at runtime. See docs/adr/0009-*.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
