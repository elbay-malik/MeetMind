# Server-only secrets. Nuxt maps NUXT_FOO_BAR -> runtimeConfig.fooBar at runtime.
# Copy to .env for local development; never commit .env.
NUXT_GROQ_API_KEY=
NUXT_GEMINI_API_KEY=
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_KEY=

